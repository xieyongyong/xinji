<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        网络权限：只为了「检查更新」这一个功能（v1.9 起）。

        工资数据、工资条图片、识别过程**全部只在本机**：
        既不上传，也不做云同步，识别是本地 ONNX 推理。
        这个权限的实际用途只有一个 —— 去 GitHub 读一下最新 Release 的版本号。
        如果不想要这个权限，删掉这一行即可，App 其余功能不受影响，
        只是设置页的「检查更新」会提示网络不可用。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 应用锁用的生物识别权限（local_auth） -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Android 9 及以下的指纹接口，保留以兼容老系统 -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!--
        也【故意】没有声明 CAMERA 权限。
        image_picker 是调系统相机 App 拍照取回结果，属于「委托拍照」，
        此时如果本 App 声明了 CAMERA 权限却没有运行时申请，会直接抛 SecurityException。
        正确做法就是像下面这样只声明 use-feature 且 required=false。
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <application
        android:label="薪迹"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:largeHeap="true">

        <!--
            文字识别服务，跑在独立进程 :ocr。

            为什么还要独立进程：识别引擎是 ONNX Runtime（native 库）跑 PP-OCR 模型，
            设备内存紧张、so 和 CPU 架构不匹配、模型文件被裁坏，都可能让进程直接消失。
            放在主进程里就是「整个 App 闪退，Dart 层来不及抛异常，日志空白」。
            隔离之后，这个进程死了主 App 还在，OcrBridge 会收到连接断开回调，
            界面提示「可手动填」，图片也不会丢。

            exported=false：只有本 App 能启动它，不对外暴露。
        -->
        <service
            android:name=".OcrService"
            android:process=":ocr"
            android:exported="false"
            android:stopWithTask="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
